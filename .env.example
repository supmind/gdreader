# This is an example file. Please create a .env file in the root directory
# and copy the contents of this file into it, then fill in your actual values.
# Do NOT commit the .env file to version control.

# Google AI API Key for Gemini Pro and Embedding models
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"

# Cohere API Key for the Rerank model
COHERE_API_KEY="YOUR_COHERE_API_KEY"

# Credentials for the specification data API
# These may be session-dependent and need to be updated periodically.
ACCESS_TOKEN="YOUR_ACCESS_TOKEN_HERE"
COOKIE="YOUR_COOKIE_STRING_HERE"
